# Copie para .env.local e preencha. Nunca commite o .env.local.

# URL do projeto Supabase (ex.: https://xxxx.supabase.co)
SUPABASE_URL=
# Chave service_role do Supabase (Project Settings → API). SÓ no servidor.
SUPABASE_SERVICE_ROLE_KEY=

# Senha do painel administrativo
ADMIN_PASSWORD=
# Segredo longo e aleatório para assinar o cookie de sessão
SESSION_SECRET=
